    <!-- Conceptos de devengos y deducciones -->
    <!ELEMENT conceptos (concepto+)>
    <!ELEMENT concepto (descripcion, devengo?, deduccion?)>
    <!ATTLIST concepto tipo (devengo | deduccion) #REQUIRED>

    <!-- Totales -->
    <!ELEMENT totales (total_devengado, total_deducido, salario_neto)>
]>

