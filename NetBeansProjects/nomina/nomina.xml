<!DOCTYPE nomina [
    <!ELEMENT nomina (empresa, trabajador, periodo, conceptos, totales)>

    <!-- Datos de la empresa -->
    <!ELEMENT empresa (nombre, cif, direccion)>

    <!-- Datos del trabajador con tus datos -->
